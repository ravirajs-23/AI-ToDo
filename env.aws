# Environment variables for AWS deployment
# Copy this file to .env and fill in your values

# AI Provider Configuration (choose one)
AI_PROVIDER=fallback
# AI_PROVIDER=chatgpt
# AI_PROVIDER=gemini

# API Keys (only needed if using AI providers)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration - AWS RDS PostgreSQL
# This will be set automatically by Elastic Beanstalk
# DATABASE_URL=postgresql://username:password@host:port/database

# CORS Configuration - Update with your frontend domain
CORS_ORIGINS=https://your-frontend-domain.com,https://your-frontend-domain.cloudfront.net

# Server Configuration
PORT=5000
HOST=0.0.0.0
